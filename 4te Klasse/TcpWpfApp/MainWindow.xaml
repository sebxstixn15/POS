<Window x:Class="TcpWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP Chat App (Server/Client)" Height="450" Width="600"
        Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Verbindungs-Einstellungen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="IP:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
            <TextBox x:Name="IpTextBox" Width="100" Text="127.0.0.1" Margin="0,0,10,0"/>
            <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
            <TextBox x:Name="PortTextBox" Width="50" Text="8080" Margin="0,0,10,0"/>
            <Button x:Name="StartServerBtn" Content="Als Server starten" Width="120" Margin="0,0,10,0" Click="StartServerBtn_Click"/>
            <Button x:Name="ConnectClientBtn" Content="Als Client verbinden" Width="130" Click="ConnectClientBtn_Click"/>
        </StackPanel>

        <!-- Chat Verlauf -->
        <ListBox x:Name="ChatListBox" Grid.Row="1" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="#4A90E2"/>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Nachrichten Eingabe -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
            <TextBox x:Name="NameTextBox" Grid.Column="0" Width="80" Text="User" Margin="45,0,10,0"/>
            
            <TextBox x:Name="MessageTextBox" Grid.Column="1" Margin="0,0,10,0"/>
            <Button x:Name="SendBtn" Grid.Column="2" Content="Senden" Width="80" Click="SendBtn_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
